# --- Public (kliensbe kerül, build időben inline-olva) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
# GitHub Pages subpath (CI állítja be: /azenegyediruham_weblap). Lokálisan hagyd üresen.
PAGES_BASE_PATH=

# --- Supabase szerveroldali / admin kulcsok (SOHA nem kerülnek a kliensbe) ---
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# postgresql://postgres:<percent-encoded-jelszo>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Opcionális: Supabase Personal Access Token (sbp_...) a CLI link / Management API használatához
SUPABASE_ACCESS_TOKEN=

# --- Későbbi integrációk (mock, amíg nincs kulcs) ---
RESEND_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FOXPOST_API_USERNAME=
FOXPOST_API_PASSWORD=
